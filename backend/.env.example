# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=portal_hlevan
DB_SSL=true

# Backend Auth & Server
PORT=5000
NODE_ENV=production
JWT_SECRET=your_random_jwt_secret_at_least_32_chars_here
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads

# Supabase Storage
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_STORAGE_BUCKET=uploads

# RAG Service (Optional - nếu deploy dịch vụ RAG riêng)
RAG_SERVICE_URL=http://localhost:8000

# Google Gemini API (Optional - dự phòng trả lời trực tiếp nếu không deploy RAG service riêng)
GEMINI_API_KEY=

