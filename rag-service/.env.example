# =======================================================
# 1. Cấu hình Chạy Cloud Miễn Phí (Google Gemini API - Khuyên Dùng)
# Đăng ký lấy API key hoàn toàn MIỄN PHÍ tại: https://aistudio.google.com/
# =======================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# =======================================================
# 2. Cấu hình Chạy Local Offline bằng Ollama (Nếu không dùng Gemini)
# =======================================================
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# =======================================================
# 3. Cấu hình chung cho Vector Store & Server
# =======================================================
CHROMA_PERSIST_DIR=./data/vector_store
RAW_DOCS_DIR=./data/raw_documents
BACKEND_URL=http://backend:5000
PORT=8000
