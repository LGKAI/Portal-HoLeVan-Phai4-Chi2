# --- Database (SQL Server) ---
DB_HOST=mssql
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Portal@Hle2024!
DB_NAME=portal_hlevan

# --- Backend ---
PORT=5000
JWT_SECRET=portal_hlevan_jwt_secret_2024_change_this_in_production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads

# --- RAG Service ---
RAG_SERVICE_URL=http://rag-service:8000

# --- Ollama (chạy trên máy host, KHÔNG trong Docker) ---
# Windows: host.docker.internal trỏ đến máy host từ trong container
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/vector_store
RAW_DOCS_DIR=./data/raw_documents

# --- Frontend (build-time) ---
VITE_API_URL=http://localhost:5000/api
