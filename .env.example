# ========================================
# Portal Họ Lê Văn - Phái 4 - Chi 2
# File mẫu biến môi trường (KHÔNG điền thông tin thật vào file này)
# Copy thành file .env cho môi trường dev cục bộ
# ========================================

# --- Cấu hình Database (PostgreSQL / Supabase) ---
# Cách 1: Dùng Connection String (Khuyên dùng cho Supabase & Render)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Cách 2: Cấu hình từng trường kết nối riêng (dành cho kết nối trực tiếp hoặc local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=portal_hlevan
DB_SSL=true

# --- Cấu hình Backend ---
PORT=5000
NODE_ENV=production
JWT_SECRET=your_random_jwt_secret_at_least_32_chars_here
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads

# --- Supabase Storage (Lưu trữ ảnh avatar & thumbnail không bị mất khi Render restart) ---
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key_here
SUPABASE_STORAGE_BUCKET=uploads

# --- Cấu hình Frontend (Build-time) ---
# Điền link Backend trên Render (ví dụ: https://portal-hlevan-backend.onrender.com/api)
VITE_API_URL=https://your-backend-service.onrender.com/api

# --- Cấu hình RAG AI (Tùy chọn) ---
RAG_SERVICE_URL=http://localhost:8000

